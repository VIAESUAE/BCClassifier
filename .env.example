# Prefer Postgres via Docker. Local default is SQLite for smoke tests.
DATABASE_URL=sqlite:///./cardrag.db
# DATABASE_URL=postgresql+psycopg://cardrag:cardrag@localhost:5432/cardrag

OPENAI_API_KEY=
# OpenRouter (recommended for demos): https://openrouter.ai/keys
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemma-2-9b-it:free
# OpenAI direct (alternative):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

UPLOAD_DIR=./uploads
DEMO_MODE=true
DATA_CLASSIFICATION=synthetic_demo
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
